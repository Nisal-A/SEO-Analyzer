NODE_ENV=development
PORT=5000
MONGODB_URI=<your Atlas connection string>
CLIENT_ORIGIN=http://localhost:5173
FETCH_TIMEOUT_MS=10000
FETCH_MAX_BYTES=2097152
FETCH_MAX_REDIRECTS=5
RATE_LIMIT_ANALYZE_PER_15MIN=10
RATE_LIMIT_GLOBAL_PER_15MIN=200
# Optional. Unlocks GET /api/audits and DELETE /api/audits/:id via the X-Admin-Key header.
# Leave empty to keep those endpoints locked (403) for everyone. Minimum 16 characters when set.
ADMIN_API_KEY=

